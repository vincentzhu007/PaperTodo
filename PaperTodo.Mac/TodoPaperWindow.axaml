<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pt="using:PaperTodo"
        x:Class="PaperTodo.Mac.TodoPaperWindow"
        Width="300" Height="360" MinWidth="220" MinHeight="160"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual">

  <Border CornerRadius="14"
          BorderBrush="#33555555" BorderThickness="1"
          BoxShadow="0 6 18 0 #40000000">
    <Border.Background>
      <SolidColorBrush Color="#FFF7F3EA" />
    </Border.Background>

    <DockPanel Margin="12">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <Button x:Name="CollapseButton" DockPanel.Dock="Right"
                Width="24" Height="24" Content="—" FontSize="14" Padding="0"
                Background="Transparent" BorderThickness="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Foreground="#88666666"
                ToolTip.Tip="折叠为胶囊" />
        <TextBlock x:Name="TitleText"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="2,0,6,0"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <ItemsControl x:Name="ItemsList" Margin="0,2,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pt:PaperItem">
            <CheckBox IsChecked="{Binding Done}" Margin="0,2">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#333333" />
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
  </Border>
</Window>
