<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaperTodo</RootNamespace>
    <AssemblyName>PaperTodo.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep satellite culture output aligned with the Windows shell. -->
    <SatelliteResourceLanguages>en;ja;ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows shell consumes core types (including internals) cross-assembly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PaperTodo</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
