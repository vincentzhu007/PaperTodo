<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PaperTodo.Mac.CapsuleWindow"
        Width="220" Height="44" MinWidth="120" MinHeight="40"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

  <Border x:Name="Pill" CornerRadius="22"
          Background="#FFF7F3EA"
          BorderBrush="#33555555" BorderThickness="1"
          BoxShadow="0 4 12 0 #40000000">
    <DockPanel Margin="12,0">
      <Button x:Name="CloseButton" DockPanel.Dock="Right"
              Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
              Content="×" FontSize="14" Padding="0"
              Background="Transparent" BorderThickness="0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Foreground="#88666666" />
      <StackPanel x:Name="Body"
                  Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center"
                  Cursor="Hand">
        <TextBlock x:Name="IconText" Text="☑" FontSize="14" Foreground="#555555" />
        <TextBlock x:Name="TitleText" FontSize="13" Foreground="#333333"
                   TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
